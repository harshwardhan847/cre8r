# Copy to `.env` and fill in. `.env` is gitignored.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave unset and no analytics script is emitted at all — the site builds and
# runs normally without it. Set it and gtag loads on every page.
VITE_GA_MEASUREMENT_ID=

# Sanity project powering /blog. Both are required — the blog pages and the
# build's prerender step read published posts straight from Sanity's CDN, no
# secret token needed. Get these from https://sanity.io/manage.
VITE_SANITY_PROJECT_ID=qg8bn70f
VITE_SANITY_DATASET=production
